[Unit]
Description=BuddyCron 补签兜底
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Codespace/BuddyCron
ExecStart=/usr/bin/python3 cli.py poll --quiet
# 预算在 runner.POLL_BUDGET（180 秒），留 60 秒余量。
TimeoutStartSec=240
StandardOutput=journal
StandardError=journal
