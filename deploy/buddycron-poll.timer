[Unit]
Description=BuddyCron 补签兜底（每 4 小时）

[Timer]
# 09:00 / 13:00 / 17:00 / 21:00 四个点。
#
# 为什么不是从 0 点起算：主签到在 09:00~10:00，补签的意义是「主签到失败时
# 兜住当天」。0 点和 3 点这种时刻，主签到还没跑过，补签只会白跑一趟。
#
# 为什么 4 小时：一天的窗口从 9 点到次日 0 点约 15 小时，4 小时给 4 次机会，
# 足够覆盖「主签到那轮撞上断网 / 服务端抖动」的情况。
OnCalendar=09,13,17,21:00:00
Persistent=true
# 15 分钟随机延迟，避开整点高峰。
RandomizedDelaySec=900
Unit=buddycron-poll.service

[Install]
WantedBy=timers.target
